# SuperMail configuration. Copy to `.env.local` and fill in to enable real integrations.
# Without these, the app runs in MOCK MAILBOX mode with realistic seeded emails.

# --- Gmail / Google OAuth (architecture is wired; not required for dev) ---
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_REDIRECT_URI=http://localhost:5273/oauth2/callback
# "token" is the browser/local SPA flow and does not need a client secret.
# Use "pkce" only if a backend/token-exchange setup is added.
VITE_GOOGLE_OAUTH_FLOW=token
# Comma-separated OAuth scopes. gmail.modify covers read/search/label/archive and
# draft creation. SuperMail NEVER sends mail, so do NOT add gmail.send — any
# gmail.send scope is stripped at load time (see src/lib/safety.ts).
VITE_GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify

# Set to "gmail" to attempt real Gmail; anything else (or empty) uses mock mode.
VITE_MAILBOX_MODE=mock

# --- AI assist (drafting / summarize / instant reply) ---
# Provider: "anthropic" | "openai" | "" (disabled -> deterministic local placeholder)
VITE_AI_PROVIDER=
VITE_AI_API_KEY=
VITE_AI_MODEL=claude-opus-4-8

# ===========================================================================
# LIVE GMAIL SYNC (recommended) — real-time mirror via the local bridge.
# Easiest setup + always-on: new mail shows in SuperMail the instant it lands.
# Put these in `.env.local` (same file as above; this Node-side bridge reads it,
# and Vite never exposes non-VITE_ vars to the browser).
#
#   1) Enable 2-Step Verification:  https://myaccount.google.com/security
#   2) Create an App Password ("Mail"): https://myaccount.google.com/apppasswords
#   3) `npm run live`  →  http://localhost:5273
#
# The bridge is IMAP-only (read-only); it cannot send mail.
GMAIL_USER=federico.donatone@growthcab.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Optional: other addresses that count as "you" (outbound detection).
GMAIL_SELF=federico@growthcab.com,federicodonatone1@gmail.com
# Optional: backfill depth, bridge port (match vite.config.ts), mailbox to mirror.
GMAIL_BACKFILL=200
BRIDGE_PORT=8787
GMAIL_MAILBOX=[Gmail]/All Mail
